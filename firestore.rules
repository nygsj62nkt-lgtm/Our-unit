rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCommander() {
      return userDocExists() && userData().role == 'commander' && userData().active == true;
    }

    function isSergeant() {
      return userDocExists() && userData().role == 'sergeant' && userData().active != false;
    }

    function isSoldier() {
      return userDocExists() && userData().role == 'soldier' && userData().active != false;
    }

    function isActiveUser() {
      return isCommander() || isSergeant() || isSoldier();
    }

    function myPersonId() {
      return userDocExists() ? userData().personId : '';
    }

    // Checks actual effective role (via person.role if synced, and excludes commanders & sergeants)
    // AND requires category in ['soldier', 'reserve'] for backward compatibility with existing docs.
    function isTrueSoldierPerson(personId) {
      return personId != '' &&
        exists(/databases/$(database)/documents/people/$(personId)) &&
        get(/databases/$(database)/documents/people/$(personId)).data.category in ['soldier', 'reserve'] &&
        get(/databases/$(database)/documents/people/$(personId)).data.get('role', 'soldier') == 'soldier';
    }

    function isTaskAssignedToMe(taskId) {
      return taskId != '' &&
        exists(/databases/$(database)/documents/tasks/$(taskId)) &&
        get(/databases/$(database)/documents/tasks/$(taskId)).data.responsibleId == myPersonId();
    }

    function isTaskForTrueSoldier(taskId) {
      return taskId != '' &&
        exists(/databases/$(database)/documents/tasks/$(taskId)) &&
        isTrueSoldierPerson(get(/databases/$(database)/documents/tasks/$(taskId)).data.responsibleId);
    }

    match /users/{uid} {
      allow read: if isCommander() || (isSignedIn() && request.auth.uid == uid);
      // Self-registration is a pending, inactive soldier with no linked person.
      // A client must never be able to promote or activate its own account.
      allow create: if isCommander() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'personId', 'active', 'createdAt']) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'soldier' &&
        request.resource.data.personId == '' &&
        request.resource.data.active == false
      );
      allow update, delete: if isCommander();
    }

    match /people/{personId} {
      // Only active users can read people; personal sensitive fields (email, phone, notes, uid)
      // are stripped in the client for non-commanders.
      allow read: if isActiveUser();
      allow write: if isCommander();
    }

    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isCommander();
    }

    match /phoneShifts/{shiftId} {
      allow read: if isActiveUser();
      allow create, update: if isCommander() || isSergeant();
      allow delete: if isCommander();
    }

    match /leaves/{leaveId} {
      allow read: if isCommander() || isSergeant() || (isSoldier() && resource.data.personId == myPersonId());
      allow create, update: if isCommander();
      allow delete: if isCommander();
    }

    match /tasks/{taskId} {
      // Commander: all tasks
      // Sergeant: tasks assigned to true soldiers ONLY (never commanders, never sergeants, not even other sergeants)
      // Soldier: ONLY tasks assigned to themselves
      allow read: if isCommander() ||
        (isSergeant() && isTrueSoldierPerson(resource.data.responsibleId)) ||
        (isSoldier() && resource.data.responsibleId == myPersonId());

      // Commander can create any task; Sergeant can ONLY create tasks assigned to a true soldier
      allow create: if isCommander() || (
        isSergeant() &&
        isTrueSoldierPerson(request.resource.data.responsibleId)
      );

      // Only Commander can delete tasks
      allow delete: if isCommander();

      // Sergeant CANNOT edit, close, or delete tasks (strictly create & assign to soldiers only).
      // Soldier can only advance status of their own assigned task (open -> in_progress -> pending_approval).
      allow update: if isCommander() || (
        isSoldier() &&
        resource.data.responsibleId == myPersonId() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedBy', 'updatedAt', 'audit', 'rejectionReason']) &&
        request.resource.data.status in ['in_progress', 'pending_approval'] &&
        (
          (resource.data.status == 'open' && request.resource.data.status == 'in_progress') ||
          (resource.data.status == 'in_progress' && request.resource.data.status == 'pending_approval')
        ) &&
        request.resource.data.audit is list &&
        resource.data.audit is list &&
        request.resource.data.audit.size() == resource.data.audit.size() + 1 &&
        request.resource.data.audit[resource.data.audit.size()].actorUid == request.auth.uid &&
        request.resource.data.audit[resource.data.audit.size()].action == request.resource.data.status &&
        request.resource.data.get('rejectionReason', '') == ''
      );
    }

    match /events/{eventId} {
      allow read: if isCommander() || ((isSergeant() || isSoldier()) && myPersonId() in resource.data.personIds);
      allow write: if isCommander();
    }

    match /duties/{dutyId} {
      allow read: if isCommander() || ((isSergeant() || isSoldier()) && resource.data.personId == myPersonId());
      allow write: if isCommander();
    }

    match /managementMessages/{msgId} {
      allow read, write: if isCommander();
    }

    match /notifications/{notifId} {
      // Soldiers & Sergeants can ONLY read notifications explicitly targeted to their own myPersonId()
      // (or general unit-wide broadcasts with targetPersonId == 'all' that are NOT tasks).
      allow read: if isCommander() || (
        (isSergeant() || isSoldier()) &&
        (
          (myPersonId() != '' && resource.data.targetPersonId == myPersonId()) ||
          (resource.data.targetPersonId == 'all' && resource.data.target != 'tasks')
        )
      );

      // Strict notification creation rules:
      // - Commander: any notification
      // - Sergeant: ONLY task notifications where entityId references an existing task assigned to a true soldier
      //   AND targetPersonId matches that task's responsibleId
      // - Soldier: ONLY task notifications where entityId references an existing task assigned to THEMSELVES (myPersonId())
      //   AND targetPersonId == myPersonId() (so other soldiers NEVER receive it, and target cannot be spoofed)
      allow create: if isCommander() || (
        isSergeant() &&
        request.resource.data.target == 'tasks' &&
        request.resource.data.get('entityId', '') != '' &&
        isTaskForTrueSoldier(request.resource.data.entityId) &&
        request.resource.data.targetPersonId == get(/databases/$(database)/documents/tasks/$(request.resource.data.entityId)).data.responsibleId
      ) || (
        isSoldier() &&
        myPersonId() != '' &&
        request.resource.data.target == 'tasks' &&
        request.resource.data.get('entityId', '') != '' &&
        isTaskAssignedToMe(request.resource.data.entityId) &&
        request.resource.data.targetPersonId == myPersonId()
      );

      // Recipient can only mark their own notification as read
      allow update: if isCommander() || (
        (isSergeant() || isSoldier()) &&
        myPersonId() != '' &&
        resource.data.targetPersonId == myPersonId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );

      allow delete: if isCommander();
    }

    match /pushTokens/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /pushEvents/{eventId} {
      allow create: if isCommander() || (
        isSergeant() &&
        request.resource.data.target == 'tasks' &&
        request.resource.data.get('entityId', '') != '' &&
        isTaskForTrueSoldier(request.resource.data.entityId)
      ) || (
        isSoldier() &&
        myPersonId() != '' &&
        request.resource.data.target == 'tasks' &&
        request.resource.data.get('entityId', '') != '' &&
        isTaskAssignedToMe(request.resource.data.entityId)
      );
      allow read, update, delete: if isCommander();
    }

    match /appState/{docId} {
      allow read, write: if isCommander();
    }

    match /backups/{backupId} {
      allow read, write: if isCommander();
    }
  }
}
